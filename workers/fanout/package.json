{
  "name": "@docbeam/worker-fanout",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "prebundle": "node -e \"require('node:fs').mkdirSync('dist/lambda',{recursive:true});require('node:fs').copyFileSync('../../packages/shared/certs/rds-ca-bundle.pem','dist/lambda/rds-ca-bundle.pem')\"",
    "bundle": "esbuild src/index.ts --bundle --platform=node --target=node22 --format=esm --minify --sourcemap --outfile=dist/lambda/index.mjs --banner:js=\"import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\""
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.1152.0",
    "@docbeam/shared": "0.0.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.164",
    "@types/pg": "^8.23.1",
    "esbuild": "^0.28.2"
  }
}

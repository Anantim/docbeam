# Copy to .env for local runs: cp .env.example .env
# Names and safe local defaults only. Never put a real secret in this file or in git.

# Postgres admin login (local container only)
POSTGRES_PASSWORD=postgres

# App-role passwords for the three databases (D-G8). Local values only.
AUTH_APP_PASSWORD=local-auth-app
PLATFORM_APP_PASSWORD=local-platform-app
DOCBEAM_APP_PASSWORD=local-docbeam-app

# LocalStack: any values work. Region matches AWS.
AWS_REGION=ap-southeast-2
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# Token checks: the issuer is the public API address (D-G5); locally the Vite server on 5173.
JWT_ISSUER=http://localhost:5173/api

# Generated by scripts/local-env.sh into .env, never written here (AGENTS.md "Secrets"):
#   JWT_PRIVATE_KEY                      RS256 key of the Auth Service
#   CLIENT_SECRET_DELIVERY_WORKER, CLIENT_SECRET_DOCBEAM_API,
#   CLIENT_SECRET_WS_HANDLERS, CLIENT_SECRET_SEED_SCRIPT
#   SEED_USER_PASSWORD                   password of the demo users
# Run: scripts/local-env.sh
